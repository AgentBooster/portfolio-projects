# Base Image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and artifacts
# Copy source code and artifacts
COPY src/ src/
COPY models/ models/
COPY data/processed/synthetic_2022_2026.csv data/processed/synthetic_2022_2026.csv
COPY data/processed/buildings_metadata.csv data/processed/buildings_metadata.csv

# Expose API port
EXPOSE 8080

# Run FastAPI with Uvicorn (Cloud Run expects $PORT env var)
# We use shell form to allow variable expansion
CMD sh -c "uvicorn src.api.main:app --host 0.0.0.0 --port \${PORT:-8080}"
