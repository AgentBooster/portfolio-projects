# Base Image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and data
COPY src/ src/
COPY models/ models/
COPY data/processed/synthetic_2022_2026.csv data/processed/synthetic_2022_2026.csv
COPY data/processed/buildings_metadata.csv data/processed/buildings_metadata.csv

# Expose Gradio port
EXPOSE 7860

# Run the Gradio app
# Cloud Run expects $PORT, Gradio uses server_port
CMD sh -c "python src/dashboard/gradio_app.py"
