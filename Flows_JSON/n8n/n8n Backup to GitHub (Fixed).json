    {
      "parameters": {
        "jsCode": "// PREPARAR DATOS Y CRUZAR CON GITHUB - VERSI\u00d3N ROBUSTA\nconst folderName = 'workflows';\nconst dateString = new Date().toISOString().split('T')[0];\n\n// 1. Obtener lista de GitHub (puede estar vac\u00eda o con error)\nconst githubFiles = {};\n\ntry {\n  const githubInput = $input.all();\n  \n  if (githubInput && githubInput.length > 0) {\n    for (const item of githubInput) {\n      const data = item.json;\n      \n      // Ignorar si hay error (carpeta no existe)\n      if (data.error || data.message) {\n        console.log('GitHub folder empty or error:', data.message);\n        continue;\n      }\n      \n      // Procesar archivo v\u00e1lido\n      if (data.name && data.sha) {\n        githubFiles[data.name] = data.sha;\n      }\n    }\n  }\n} catch (e) {\n  console.log('Error processing GitHub files, assuming empty folder:', e.message);\n}\n\nconsole.log('Existing GitHub files:', Object.keys(githubFiles).length);\n\n// 2. Obtener workflows\nconst workflows = $('Get All Workflows').all();\n\nif (!workflows || workflows.length === 0) {\n  throw new Error('No workflows found to backup');\n}\n\n// 3. Preparar items para cada workflow\nconst results = [];\n\nfor (const item of workflows) {\n  const wf = item.json;\n  \n  if (!wf.id) {\n    console.log('Skipping workflow without ID');\n    continue;\n  }\n  \n  const fileName = `${wf.id}.json`;\n  const exists = githubFiles.hasOwnProperty(fileName);\n  \n  results.push({\n    json: {\n      path: `${folderName}/${fileName}`,\n      content: JSON.stringify(wf, null, 2),\n      commitMsg: `Backup: ${wf.name || 'Unnamed'} [${dateString}]`,\n      sha: exists ? githubFiles[fileName] : null,\n      operation: exists ? 'update' : 'create',\n      workflowName: wf.name || 'Unnamed',\n      workflowId: wf.id\n    }\n  });\n}\n\nconsole.log(`Prepared ${results.length} workflows: ${results.filter(r => r.json.operation === 'create').length} new, ${results.filter(r => r.json.operation === 'update').length} updates`);\n\nreturn results;"
      },
      "id": "63b5bb8a-1f7b-4cab-a663-7ac7d20783ad",
      "name": "Prepare Workflows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "// PREPARAR DUMP DE CREDENCIALES - VERSI\u00d3N ROBUSTA\nconst folderName = 'credentials';\nconst fileName = 'credentials_dump.json';\nconst dateString = new Date().toISOString().split('T')[0];\n\n// 1. Obtener credenciales\nconst allCreds = $('Get Creds from DB').all().map(item => item.json);\n\nif (!allCreds || allCreds.length === 0) {\n  console.log('No credentials found, creating empty backup');\n}\n\n// 2. Verificar si existe el archivo en GitHub\nlet sha = null;\n\ntry {\n  const githubInput = $input.all();\n  \n  if (githubInput && githubInput.length > 0) {\n    for (const item of githubInput) {\n      const data = item.json;\n      \n      // Ignorar errores\n      if (data.error || data.message) {\n        console.log('GitHub folder empty or error:', data.message);\n        continue;\n      }\n      \n      // Buscar nuestro archivo\n      if (data.name === fileName && data.sha) {\n        sha = data.sha;\n        console.log('Found existing credentials file with SHA:', sha);\n        break;\n      }\n    }\n  }\n} catch (e) {\n  console.log('Error checking GitHub, will create new file:', e.message);\n}\n\nconst operation = sha ? 'update' : 'create';\nconsole.log(`Credentials backup: ${operation} (${allCreds.length} credentials)`);\n\nreturn [{\n  json: {\n    path: `${folderName}/${fileName}`,\n    content: JSON.stringify(allCreds, null, 2),\n    commitMsg: `Backup Credentials [${dateString}] - ${allCreds.length} items`,\n    sha: sha,\n    operation: operation\n  }\n}];"
      },
